{
  "name": "@subcult/subsets",
  "version": "0.2.0-alpha.1",
  "description": "Group your agent skills. Activate the set you need.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "subsets": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/discovery-ownership.md",
    "docs/npm.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test node/tests/*.test.mjs",
    "prepack": "npm run build",
    "format": "prettier --write node package.json tsconfig.json",
    "format:check": "prettier --check node package.json tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://git.subcult.tv/subculture-collective/subsets.git"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "registry": "https://git.subcult.tv/api/packages/subculture-collective/npm/",
    "access": "public"
  },
  "os": [
    "linux",
    "darwin"
  ]
}
